# Copy this file to .env.testing in the repository root (it's gitignored)
# to run the integration test suite against a real Hosting Admin API
# instance: composer test-integration
#
# These tests never run as part of `composer test` / CI — they only run
# when explicitly invoked and configured.

SPEEDWEB_API_KEY=swk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPEEDWEB_BASE_URI=https://admin.swdev.speedweb.sk

# Optional: pin domain-scoped tests (DNS/FTP/mailboxes/databases) to a
# specific domain instead of whichever one is first in `GET /domains`.
#SPEEDWEB_TEST_DOMAIN_ID=123

# Optional opt-ins for mutating tests (off by default):
#
# SPEEDWEB_TEST_CREATE=1
#   Runs tests that CREATE a DNS TXT record, an FTP account, and a mailbox,
#   then delete them again through the DELETE endpoints. Nothing is left
#   behind on success; each test still prints what it created/deleted.
#
# SPEEDWEB_TEST_DESTRUCTIVE=1
#   Runs tests that mutate an EXISTING resource on the account:
#     - changes the password of an existing database user (no way to create
#       a throwaway one through this API; the new password is printed to
#       stderr so it can be recovered)
#     - toggles DNSSEC on the first domain, then toggles it back
#     - assigns a real domain to the first subuser, then unassigns it again
#       (skipped if that domain is already assigned, to avoid clobbering it)
#
# SPEEDWEB_TEST_BILLING_WRITE=1
#   Runs a test that creates a throwaway billed service (topay), updates
#   it, then deletes it. Separate from SPEEDWEB_TEST_CREATE because billed
#   services can trigger real recurring invoices if something goes wrong.
#   The customer id defaults to one copied from an existing service, which
#   isn't guaranteed to be valid for writes (the create endpoint validates
#   it separately from read access) — set SPEEDWEB_TEST_BILLING_CUSTOMER_ID
#   to a known-valid customer id if the default gets rejected.
#SPEEDWEB_TEST_CREATE=1
#SPEEDWEB_TEST_DESTRUCTIVE=1
#SPEEDWEB_TEST_BILLING_WRITE=1
#SPEEDWEB_TEST_BILLING_CUSTOMER_ID=1
