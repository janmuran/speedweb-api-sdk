{
    "name": "janmuran/speedweb-api-sdk",
    "description": "PHP SDK client for the Speedweb Hosting Admin API",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["speedweb", "hosting", "api", "sdk"],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "php-http/mock-client": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "autoload": {
        "psr-4": {
            "JanMuran\\SpeedwebApiSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JanMuran\\SpeedwebApiSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
